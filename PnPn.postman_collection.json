            {
              "name": "2./login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// 1. Parse the JSON response body",
                      "const responseJson = pm.response.json();",
                      "",
                      "// 2. Extract the token (adjust 'access_token' to match your exact JSON key)",
                      "const accessToken = responseJson.accessToken;",
                      "",
                      "// 3. Save the token to your preferred variable scope:",
                      "pm.environment.set(\"pnpn_auth_accessToken\", accessToken);         // Option A: Environment Scope (Recommended)",
                      "// pm.collectionVariables.set(\"my_access_token\", token); // Option B: Collection Scope",
                      "// pm.globals.set(\"my_access_token\", token);             // Option C: Global Scope",
                      "",
                      "pm.environment.set(\"pnpn_auth_userId\", responseJson.userId);",
                      "pm.environment.set(\"pnpn_auth_refreshToken\", responseJson.refreshToken);",
                      "",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
